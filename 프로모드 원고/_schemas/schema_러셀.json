{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schema_러셀.json",
  "title": "프레게3 + 러셀 1/2/3 프로모드 원고 챕터 표준 스키마",
  "description": "한 챕터 = 한 파일. 표준 흐름: 문법 지문(개념) → 내용 확인(표) → 분석 훈련(러셀만) → 단답형 → 객관식. 프레게3은 약식: 분석 훈련·내용 확인 생략 허용. 프레게3은 추가 area=개념 섹션 허용.",

  "type": "object",
  "required": ["meta", "sections"],
  "additionalProperties": false,

  "properties": {
    "meta": {
      "type": "object",
      "required": ["level", "chapter", "title", "language"],
      "properties": {
        "level":     { "type": "string", "enum": ["프레게3", "러셀1", "러셀2", "러셀3"] },
        "chapter":   { "type": "integer", "minimum": 1, "maximum": 20 },
        "title":     { "type": "string" },
        "language":  { "type": "string", "const": "ko-KR" },
        "createdAt": { "type": "string" },
        "version":   { "type": "string" },
        "originalFile": { "type": "string" },
        "isAbridged":   { "type": "boolean", "description": "프레게3=true, 러셀=false" }
      }
    },

    "sections": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/section" }
    }
  },

  "definitions": {
    "section": {
      "type": "object",
      "required": ["type", "area", "content"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "concept", "passage",
            "activity", "question", "writing",
            "summary_table", "answer_explain", "model_answer",
            "section_group"
          ]
        },
        "area": {
          "type": "string",
          "enum": ["문법", "개념", "어휘", "문학", "비문학", "실력확인", "기타"]
        },
        "subtype": { "type": "string" },
        "title":   { "type": "string" },
        "id":      { "type": "string" },
        "content": { "type": ["object", "array", "string"] },
        "notes":   { "type": "string" }
      }
    },

    "concept_content": {
      "type": "object",
      "required": ["text"],
      "description": "문법_지문 또는 개념_지문에 해당. 문법 규칙·이론 설명.",
      "properties": {
        "title":    { "type": "string" },
        "text":     { "type": "string", "description": "단락은 \\n\\n 구분" },
        "examples": { "type": "array" }
      }
    },

    "activity_content": {
      "type": "object",
      "description": "subtype 예: fill_table(내용 확인 표) / analysis_training(분석 훈련, 러셀만) / classify / arrange.",
      "properties": {
        "instruction": { "type": "string" },
        "table": {
          "type": "object",
          "description": "subtype=fill_table 일 때 사용",
          "properties": {
            "headers": { "type": "array", "items": { "type": "string" } },
            "rows": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "cells":       { "type": "array" },
                  "blank_cells": { "type": "array", "description": "빈칸으로 둘 cell 인덱스" },
                  "answers":     { "type": "array" }
                }
              }
            },
            "answer_text": { "type": "string", "description": "표 정답 일괄 텍스트" }
          }
        },
        "items": { "type": "array", "description": "subtype=analysis_training 등에서 문제 배열" }
      }
    },

    "question_content": {
      "type": "object",
      "required": ["items"],
      "description": "subtype 예: short_answer / multiple_choice / essay.",
      "properties": {
        "instruction": { "type": "string" },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["number", "stem"],
            "properties": {
              "number":  { "type": ["integer", "string"] },
              "stem":    { "type": "string" },
              "box":     { "type": "string" },
              "choices": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["id", "text"],
                  "properties": {
                    "id":        { "type": "string" },
                    "text":      { "type": "string" },
                    "isCorrect": { "type": "boolean" }
                  }
                }
              },
              "answer":      {},
              "explanation": { "type": "string" },
              "points":      { "type": "number" }
            }
          }
        }
      }
    },

    "answer_explain_content": {
      "type": "object",
      "required": ["items"],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["refId"],
            "properties": {
              "refId":       { "type": "string" },
              "answer":      {},
              "explanation": { "type": "string" }
            }
          }
        }
      }
    },

    "model_answer_content": {
      "type": "object",
      "required": ["items"],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["refId", "answer"],
            "properties": {
              "refId":   { "type": "string" },
              "answer":  { "type": "string" },
              "scoring": { "type": "array" }
            }
          }
        }
      }
    }
  }
}

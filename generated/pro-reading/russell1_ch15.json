  {
    "contentType": "PRO_READING",
    "title": "홍길동전",
    "targetLevel": "russell1",
    "area": "READING",
    "subArea": "LITERATURE",
    "timeLimitSec": 420,
    "seedReward": {
      "seedType": "seed_rice",

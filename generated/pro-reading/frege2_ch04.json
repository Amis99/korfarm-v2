  {
    "contentType": "PRO_READING",
    "title": "토끼전",
    "targetLevel": "frege2",
    "area": "READING",
    "subArea": "LITERATURE",
    "timeLimitSec": 300,
    "seedReward": {
      "seedType": "seed_rice",

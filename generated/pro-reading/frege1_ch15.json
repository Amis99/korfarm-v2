  {
    "contentType": "PRO_READING",
    "title": "강물이 휘돌아 가는 안동 하회마을 여행",
    "targetLevel": "frege1",
    "area": "READING",
    "subArea": "LITERATURE",
    "timeLimitSec": 300,
    "seedReward": {
      "seedType": "seed_rice",
      "count": 3,
      "multiplier": 1

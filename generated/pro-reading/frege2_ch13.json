  {
    "contentType": "PRO_READING",
    "title": "돌다리",
    "targetLevel": "frege2",
    "area": "READING",
    "subArea": "LITERATURE",
    "timeLimitSec": 300,
    "seedReward": {
      "seedType": "seed_rice",

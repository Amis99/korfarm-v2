  {
    "contentType": "PRO_READING",
    "title": "전우치전",
    "targetLevel": "russell3",
    "area": "READING",
    "subArea": "LITERATURE",
    "timeLimitSec": 300,
    "seedReward": {
      "seedType": "seed_rice",

  {
    "contentType": "PRO_READING",
    "title": "돌고 도는 생명의 그물, 생태계",
    "targetLevel": "frege2",
    "area": "READING",
    "subArea": "NONFICTION",
    "timeLimitSec": 300,
    "seedReward": {

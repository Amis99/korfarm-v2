  {
    "contentType": "PRO_READING",
    "title": "에리히 프롬이 말하는 행복",
    "targetLevel": "frege3",
    "area": "READING",
    "subArea": "NONFICTION",
    "timeLimitSec": 300,
    "seedReward": {
      "seedType": "seed_rice",
      "count": 3,
      "multiplier": 1

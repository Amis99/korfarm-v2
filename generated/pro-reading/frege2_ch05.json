  {
    "contentType": "PRO_READING",
    "title": "우장춘 박사의 씨앗 이야기",
    "targetLevel": "frege2",
    "area": "READING",
    "subArea": "LITERATURE",
    "timeLimitSec": 300,
    "seedReward": {
      "seedType": "seed_rice",
      "count": 3,
      "multiplier": 1

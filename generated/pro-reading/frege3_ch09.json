  {
    "contentType": "PRO_READING",
    "title": "소중한 내 그림을 지키는 기술, 워터마킹",
    "targetLevel": "frege3",
    "area": "READING",
    "subArea": "NONFICTION",
    "timeLimitSec": 300,
    "seedReward": {
      "seedType": "seed_rice",

{
  "contentId": "dr-frege3-213",
  "title": "213일차, [비문학] 수소 연료전지",
  "description": "213일차, [비문학] 수소 연료전지",
  "targetLevel": "FREGE_3",
  "schoolGradeRange": {
    "min": 6,

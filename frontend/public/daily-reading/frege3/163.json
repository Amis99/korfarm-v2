{
  "contentId": "dr-frege3-163",
  "title": "163일차, [비문학] 3D 프린팅 적층 제조",
  "description": "163일차, [비문학] 3D 프린팅 적층 제조",
  "targetLevel": "FREGE_3",
  "schoolGradeRange": {
    "min": 6,

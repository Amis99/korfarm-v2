{
  "contentId": "dr-frege3-214",
  "title": "214일차, [비문학] 에너지 저장 장치",
  "description": "214일차, [비문학] 에너지 저장 장치",
  "targetLevel": "FREGE_3",
  "schoolGradeRange": {

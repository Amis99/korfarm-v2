{
  "contentId": "dr-frege3-171",
  "title": "171일차, [비문학] 민주주의와 포퓰리즘",
  "description": "171일차, [비문학] 민주주의와 포퓰리즘",
  "targetLevel": "FREGE_3",
  "schoolGradeRange": {
    "min": 6,

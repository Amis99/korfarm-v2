{
  "contentId": "dr-frege3-215",
  "title": "215일차, [비문학] 웹툰의 스크롤 서사",
  "description": "215일차, [비문학] 웹툰의 스크롤 서사",
  "targetLevel": "FREGE_3",
  "schoolGradeRange": {
    "min": 6,

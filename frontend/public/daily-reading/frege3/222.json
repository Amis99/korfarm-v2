{
  "contentId": "dr-frege3-222",
  "title": "222일차, [비문학] 가짜뉴스의 확산",
  "description": "222일차, [비문학] 가짜뉴스의 확산",
  "targetLevel": "FREGE_3",
  "schoolGradeRange": {
    "min": 6,

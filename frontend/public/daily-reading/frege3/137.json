{
  "contentId": "dr-frege3-137",
  "title": "137일차, [문학] 자전거 도둑 5부: 돌아보는 끝",
  "description": "자전거 도둑 마지막",
  "targetLevel": "FREGE_3",
  "schoolGradeRange": {
    "min": 6,

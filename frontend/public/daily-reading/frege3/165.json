{
  "contentId": "dr-frege3-165",
  "title": "165일차, [비문학] 리쾨르의 서사 정체성",
  "description": "165일차, [비문학] 리쾨르의 서사 정체성",
  "targetLevel": "FREGE_3",
  "schoolGradeRange": {
    "min": 6,

{
  "contentId": "dr-frege3-183",
  "title": "183일차, [비문학] 스마트그리드",
  "description": "183일차, [비문학] 스마트그리드",
  "targetLevel": "FREGE_3",
  "schoolGradeRange": {
    "min": 6,

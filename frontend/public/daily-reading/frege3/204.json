{
  "contentId": "dr-frege3-204",
  "title": "204일차, [비문학] 기억과 자아의 연속성",
  "description": "204일차, [비문학] 기억과 자아의 연속성",
  "targetLevel": "FREGE_3",
  "schoolGradeRange": {

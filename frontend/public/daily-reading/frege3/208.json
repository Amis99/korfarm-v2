{
  "contentId": "dr-frege3-208",
  "title": "208일차, [문학] 쉽게 씌어진 시",
  "description": "208일차, [문학] 쉽게 씌어진 시",
  "targetLevel": "FREGE_3",
  "schoolGradeRange": {
    "min": 6,

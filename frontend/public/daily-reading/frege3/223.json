{
  "contentId": "dr-frege3-223",
  "title": "223일차, [비문학] 유체역학과 양력",
  "description": "223일차, [비문학] 유체역학과 양력",
  "targetLevel": "FREGE_3",
  "schoolGradeRange": {
    "min": 6,

{
  "contentId": "dr-frege3-232",
  "title": "232일차, [비문학] 국제 난민 체제",
  "description": "232일차, [비문학] 국제 난민 체제",
  "targetLevel": "FREGE_3",
  "schoolGradeRange": {
    "min": 6,
    "max": 6

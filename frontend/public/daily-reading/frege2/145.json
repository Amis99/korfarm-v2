{
  "contentId": "dr-frege2-145",
  "title": "145일차, [비문학] 해저 데이터 케이블",
  "description": "145일차, [비문학] 해저 데이터 케이블",
  "targetLevel": "FREGE_2",
  "schoolGradeRange": {
